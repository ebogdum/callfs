# CallFS Configuration Example
server:
  listen_addr: ":8443"
  protocol: "https"            # http | https | auto
  external_url: "localhost:8443"  # Used for single-use download links
  cert_file: "server.crt"
  key_file: "server.key"
  enable_quic: false
  quic_listen_addr: ":8443"    # UDP address for HTTP/3 (QUIC)
  read_timeout: 30s
  write_timeout: 30s
  file_op_timeout: 10s
  metadata_op_timeout: 5s

auth:
  # Preferred: bind each key to an explicit app user ID. The user ID is stored as
  # the "owner" of everything the key creates, and stays stable when other keys
  # are revoked, rotated, or reordered.
  api_key_users:
    alice: "your-api-key-here-at-least-16-chars"
  # Legacy alternative: user IDs are derived from list position (api-user-0, ...).
  # Removing or reordering an entry shifts every later key's identity and hands
  # the removed user's files to the next key holder. Only append to this list.
  # api_keys:
  #   - "your-api-key-here-at-least-16-chars"
  internal_proxy_secret: "your-internal-secret-here-16ch"
  single_use_link_secret: "your-link-secret-here-16chars"

log:
  level: "info"                # debug | info | warn | error
  format: "json"               # json | console

metrics:
  listen_addr: ":9090"         # Separate unauthenticated metrics port

performance:
  mode: "fast"                 # fast | strict; both keep every acknowledged write

backend:
  default_backend: "localfs"   # localfs | s3
  localfs_root_path: "/var/lib/callfs"
  s3_access_key: ""
  s3_secret_key: ""
  s3_region: "us-east-1"
  s3_bucket_name: ""
  s3_endpoint: ""              # Custom S3 endpoint (e.g., http://minio:9000)
  s3_server_side_encryption: "AES256"  # AES256 | aws:kms | "" (disable for MinIO)
  s3_acl: "private"
  s3_kms_key_id: ""            # KMS key ID for SSE-KMS
  internal_proxy_skip_tls_verify: false

metadata_store:
  type: "postgres"             # postgres | sqlite | redis | nats
  dsn: "postgres://callfs:CHANGE_ME@localhost/callfs?sslmode=require"
  sqlite_path: "./callfs.sqlite3"
  redis_addr: "localhost:6379"
  redis_password: ""
  redis_db: 0
  redis_key_prefix: "callfs:"

nats:
  enabled: false               # required whenever more than one node runs
  mode: "embedded"             # embedded | external
  server_name: ""              # defaults to instance_discovery.instance_id
  cluster_name: "callfs"
  client_listen: ""            # "" = in-process only; e.g. 127.0.0.1:4222 for the nats CLI
  cluster_listen: "127.0.0.1:6222"  # non-loopback needs tls.cert_file, key_file and ca_file
  routes: []                   # e.g. ["nats-route://10.0.0.2:6222"]
  routes_from_peers: true      # derive routes from instance_discovery.peer_endpoints hosts
  monitor_listen: ""           # optional NATS HTTP monitor, e.g. 127.0.0.1:8222
  server_tags: {}              # e.g. {zone: a}
  tls:
    cert_file: ""
    key_file: ""
    ca_file: ""
    client_cert_file: ""
    client_key_file: ""
  auth:
    mode: "derived"            # derived | nkey | creds (external mode needs nkey or creds)
    nkey_seed_file: ""
    creds_file: ""
    previous_secret: ""        # old auth.internal_proxy_secret, accepted during a rolling rotation
  jetstream:
    store_dir: "./data/nats"
    max_memory: 256MiB
    max_store: 0               # 0 = unlimited
    sync: "always"             # always | interval
    sync_interval: 2m
    unique_tag: ""
  external:
    urls: []                   # nats://host:4222
    js_domain: ""
    tls_ca_file: ""
  rpc_timeout: 10s
  metadata:
    replicas: 3
    apply_timeout: 10s
    read_barrier: "info"       # info | publish
    miss_barrier: true
    snapshot_interval: 5m
    snapshot_every: 50000
    retain_commands: 100000
    retain_snapshots: 3
    max_msg_size: 8MiB
  locks:
    replicas: 3
    ttl: 15s
    queue_stale: 3s
  streams:
    replicas: 3
    events_max_age: 168h
    events_max_bytes: 1GiB
    audit_max_age: 2160h
    logs_level: "warn"         # debug | info | warn | error
    logs_max_age: 72h
    tasks_max_deliver: 8
    tasks_backoff: [1s, 5s, 30s, 2m, 10m]
    dlq_max_age: 720h
  bytes: "http"                # http | chunked
  counters: false

dlm:
  type: "redis"                # redis | local | nats
  redis_addr: "localhost:6379"
  redis_password: ""

ha:
  replication_enabled: false
  replica_backend: ""          # localfs | s3
  require_replica_success: false

erasure:
  enabled: false
  data_shards: 4
  parity_shards: 2
  shard_backend: "localfs"     # localfs | s3

instance_discovery:
  instance_id: "callfs-instance-1"
  peer_endpoints: {}           # instance_id -> http(s) endpoint
